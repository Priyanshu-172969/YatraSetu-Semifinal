# YatraSetu Environment Configuration
# Copy this file to .env and adjust credentials for your local MySQL server

# MySQL Connection Settings
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yatrasetu_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password_here

# Flask Secret Key for session security, CSRF protection, and flash messages
# IMPORTANT: Replace with a private, unpredictable secret key for non-development use
SECRET_KEY=yatrasetu-local-dev-secret-key-change-in-production

# Flask Debug Mode (Set to 1 or True for local development auto-reload, 0 or False for production safety)
FLASK_DEBUG=1
